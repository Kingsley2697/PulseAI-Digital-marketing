# ==============================================================================
# PULSEAI DIGITAL - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# 1. DATABASE CONFIGURATION (MongoDB with Mongoose)
# Provide your local or MongoDB Atlas connection string.
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/pulseai_digital?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pulseai_digital

# 2. REAL-TIME NOTIFICATIONS (Telegram Bot Alert Dispatcher)
# Create a bot via @BotFather on Telegram, grab the bot token and your chat/channel ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Email webhook (e.g. Zapier, Make, or custom HTTP endpoint)
EMAIL_NOTIFICATION_WEBHOOK=

# 2B. LEAD AUTOMATION
# OpenRouter routes each task to its assigned model. Create the key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=or-v1-your-key-here
# Model routing policy. Change these slugs to match your preferred OpenRouter models.
OPENROUTER_BACKEND_LEAD_SCORING_MODEL=openai/gpt-4o
OPENROUTER_CLIENT_COPYWRITING_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BULK_BRAINSTORMING_MODEL=google/gemini-2.5-flash

# HubSpot CRM (Private App access token). Each submitted lead is created as a contact.
HUBSPOT_PRIVATE_APP_TOKEN=

# Client email acknowledgement via Resend. Configure a verified sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PulseAI Digital <hello@yourdomain.com>
ADMIN_EMAIL=team@yourdomain.com

# Calendar link included in email acknowledgements.
CALENDLY_SCHEDULING_URL=https://calendly.com/your-team/strategy-call

# WhatsApp Cloud API acknowledgement. WhatsApp requires an approved template for business-initiated messages.
# The configured template must accept one body variable: the client's name.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=lead_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en

# Staff-review WhatsApp alert. Create an approved template with one body variable,
# which will receive the alert text and staff dashboard link.
STAFF_WHATSAPP_NUMBER=
STAFF_WHATSAPP_TEMPLATE_NAME=staff_brief_ready
STAFF_WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional override for the recipient of staff-review emails. Falls back to ADMIN_EMAIL.
STAFF_NOTIFICATION_EMAIL=

# Protects staff-only workflow actions, such as sending an approved proposal.
# Generate a long random secret; never expose this value to the browser.
INTERNAL_AUTOMATION_TOKEN=

# Staff approval dashboard. Use a dedicated internal email, a strong password,
# and a random 32-byte session secret for the signed, HTTP-only session cookie.
STAFF_DASHBOARD_EMAIL=team@yourdomain.com
STAFF_DASHBOARD_PASSWORD=
STAFF_SESSION_SECRET=

# 3. PAYMENT GATEWAY 1: FLUTTERWAVE (NGN Naira & African Cards / USSD / Bank Transfer)
# Obtain these from your Flutterwave Dashboard -> Settings -> API Keys
FLUTTERWAVE_SECRET_KEY=

# 4. PAYMENT GATEWAY 2: CRYPTO WALLETS (International USD Client Billing)
# USDT TRC-20, USDT ERC-20, Bitcoin, and Ethereum deposit receiving wallets
CRYPTO_USDT_TRC20_WALLET=
CRYPTO_USDT_ERC20_WALLET=
CRYPTO_ETH_WALLET=
CRYPTO_BTC_WALLET=

# 5. APPLICATION BASE URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 6. CANVA CONNECT API (server-side OAuth credentials)
# Configure the same redirect URL in the Canva Developer Portal.
CANVA_CLIENT_ID=your_canva_client_id_here
CANVA_CLIENT_SECRET=your_canva_client_secret_here
CANVA_REDIRECT_URI=https://pulseaidigital.com/api/canva/callback
# Base64-encoded 32-byte key used to encrypt stored OAuth tokens. Never expose it to the browser.
CANVA_TOKEN_ENCRYPTION_KEY=
# The published Brand Template ID. Field mapping is configured before enabling autofill.
CANVA_BRAND_TEMPLATE_ID=
CANVA_AUTOFILL_FIELD_MAP={}

# Invoke POST /api/internal/jobs/process with Authorization: Bearer <INTERNAL_AUTOMATION_TOKEN>
# on a trusted scheduler at least once per minute to process and retry queued AI automation jobs.
